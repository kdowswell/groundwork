{
  "name": "@kdowswell/groundwork",
  "version": "0.0.2",
  "description": "Architectural grounding for AI coding agents \u2014 distilled principle files agents reference during planning.",
  "type": "module",
  "license": "MIT",
  "author": "Kurt Dowswell <kdowswell@gmail.com>",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "groundwork": "cli/bin/groundwork.mjs"
  },
  "files": [
    "cli/",
    "skills/",
    "principles/",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "validate": "tsx scripts/validate-principles.ts",
    "validate:skills": "tsx scripts/validate-skills.ts",
    "validate:all": "npm run validate && npm run validate:skills",
    "sync:principles": "tsx scripts/sync-skill-principles.ts",
    "sync:router": "tsx scripts/sync-router-references.ts",
    "sync:all": "npm run sync:principles && npm run sync:router",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "eval": "tsx eval/harness.ts",
    "eval:skill": "tsx eval/harness.ts",
    "eval:plugin": "claude plugin eval . --scaffold --trust-plugin --allow-tools Bash Write Edit --no-publish"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "@types/node": "^22.10.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "glob": "^11.0.0",
    "gray-matter": "^4.0.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kdowswell/groundwork.git"
  }
}
